# ==============================================================================
# ATS Optimizer - Environment Template (.env.example)
# Copie este arquivo para .env e preencha suas configurações.
# ==============================================================================

# PostgreSQL
POSTGRES_DB=ats_optimizer
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=ats_password

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Spring AI (OpenAI API ou modelo local compatível como Ollama / LM Studio)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
